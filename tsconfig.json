{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // What `engine.ts` serves a module as `collie`, so the shipped workflows are checked
    // against the objects they actually run with.
    "paths": { "collie": ["./src/collie-module.ts"] },
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "refactors": true,
        "quickinfo": true,
        "completions": true
      }
    ]
  },
  // Workflow modules an author would write, typechecked by the toolchain Collie
  // provisions rather than by this project — one of them is deliberately wrong.
  "exclude": ["test/fixtures/workflows"],
  "include": ["src", "test", "workflows"]
}

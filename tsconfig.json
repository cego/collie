{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "refactors": true,
        "quickinfo": true,
        "completions": true
      }
    ]
  },
  "include": ["src", "test"]
}

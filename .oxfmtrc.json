{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    // Third-party sources, pinned as submodules and never edited here.
    "desktop-rune/vendor/**",
    // Agent messages kept verbatim, as the rendering corpus draws them.
    "desktop-rune/fixtures/corpus/**",
    // `bun run tools/rune-fixtures.ts` writes it as one line.
    "desktop-rune/fixtures/flows.json",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".scratch/**",
    ".windsurf/**",
    "advisor-plans/**",
    "plans/**",
    // Exported brand assets stay byte-identical to the kit and its checksum manifest.
    "assets/brand/**",
    // Merge request notes as their forge holds them.
    "test/fixtures/public-text/**",
    // herdr prints this; `bun run contract:regen` writes it verbatim and CI diffs it.
    "herdr-api-schema.json",
    // herdr-core's released.openrpc.json, copied verbatim for the pin.
    "hc.openrpc.json",
    "tools/oxlint/anti-slop/**"
  ]
}

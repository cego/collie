    "@iconify-json/lucide": "1.2.140",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nuxt/ui": "4.11.3",
    "@pierre/diffs": "1.5.1",
    "@tanstack/ai-client": "0.37.0",
    "@tanstack/ai-vue": "0.25.5",
    "@xterm/addon-fit": "0.11.0",

{
  "name": "collie-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "view": "electrobun prepare && nuxi generate view",
    "start": "bun run view && electrobun dev",
    "build": "bun run view && electrobun build --env=stable",

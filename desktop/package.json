{
  "name": "collie-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "view": "nuxi generate view",
    "start": "bun run view && electrobun dev",
    "build": "bun run view && electrobun build --env=stable",
    "typecheck": "electrobun prepare && tsc --noEmit && nuxi typecheck view",
    "test": "bun run view && COLLIE_DESKTOP_CDP=9333 electrobun build && bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@comark/nuxt": "0.7.0",
    "@comark/vue": "0.7.0",
    "@effect/atom-vue": "4.0.0-rc.117",
    "@fontsource-variable/public-sans": "5.3.0",
    "@iconify-json/lucide": "1.2.138",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@nuxt/ui": "4.11.3",
    "@tanstack/ai-client": "0.36.1",
    "@tanstack/ai-vue": "0.25.4",
    "beautiful-mermaid": "1.1.3",
    "comark": "0.7.0",
    "electrobun": "2.0.2",
    "nuxt": "4.5.2",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@types/bun": "latest",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.12"
  }
}

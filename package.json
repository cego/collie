{
  "name": "collie",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "acceptance": "bun run tools/acceptance.ts",
    "contract:check": "bun run tools/herdr-schema.ts pinned --check",
    "contract:regen": "bun run tools/herdr-schema.ts pinned --write",
    "typecheck": "tsc --noEmit",
    "build": "bun run tools/build.ts",
    "smoke": "sh tools/smoke.sh bin/collie"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "effect": "4.0.0-rc.112",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@effect/tsgo": "0.38.0",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "latest",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}

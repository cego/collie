{
  "name": "collie",
  "version": "1.0.24",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "postinstall": "bun install --cwd desktop --frozen-lockfile",
    "lint": "bun run lint:ts",
    "lint:ts": "effect-tsgo oxlint",
    "lint:fix": "effect-tsgo oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun run tools/test.ts",
    "scenario": "bun run tools/scenario.ts",
    "test:live": "COLLIE_LIVE_HARNESSES=1 bun test test/agents.test.ts test/compaction-claude.test.ts test/compaction-codex.test.ts test/compaction-opencode.test.ts test/compaction-pi.test.ts",
    "probe:hc": "bun run tools/hc-probe.ts",
    "typecheck": "tsrs --noEmit --fast",
    "rune-types:check": "bun run tools/rune-types.ts --check",
    "prompt-golden:write": "bun run tools/prompt-golden.ts --write",
    "prompt-golden:check": "bun run tools/prompt-golden.ts --check",
    "check:static": "bun run --parallel --no-exit-on-error format:check lint typecheck rune-types:check",
    "check": "bun run check:static && bun run test",
    "build": "bun run tools/build.ts",
    "smoke": "sh tools/smoke.sh bin/collie"
  },
  "dependencies": {
    "@comark/ansi": "0.9.2",
    "@effect/platform-bun": "4.1.4",
    "@effect/sql-sqlite-bun": "4.1.4",
    "@opentui/core": "^0.8.4",
    "@opentui/solid": "^0.8.4",
    "comark": "0.9.2",
    "effect": "4.1.4",
    "forges": "0.3.2",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.1.0",
    "@effect/tsgo": "0.73.4",
    "@interfere/landmines": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "1.4.4",
    "msw": "2.15.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "patchedDependencies": {
    "effect@4.1.4": "patches/effect@4.1.4.patch"
  }
}

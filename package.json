{
  "name": "collie",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun run tools/test.ts",
    "acceptance": "bun run tools/acceptance.ts",
    "contract:check": "bun run tools/herdr-schema.ts pinned --check",
    "contract:regen": "bun run tools/herdr-schema.ts pinned --write",
    "typecheck": "tsc --noEmit",
    "check": "bun run --parallel --no-exit-on-error format:check lint typecheck && bun run test",
    "build": "bun run tools/build.ts",
    "smoke": "sh tools/smoke.sh bin/collie"
  },
  "dependencies": {
    "@comark/ansi": "0.7.0",
    "@effect/platform-bun": "4.0.1",
    "@effect/sql-sqlite-bun": "4.0.1",
    "@opentui/core": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "comark": "0.7.0",
    "effect": "4.0.1",
    "solid-js": "^1.9.16"
  },
  "devDependencies": {
    "@effect/tsgo": "0.50.0",
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
